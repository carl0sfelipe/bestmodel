# Copy to deploy/.env and fill in. Never commit the filled file.

# --- database (CHANGE BOTH) ---
POSTGRES_USER=bestmodel
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=bestmodel

# --- domains ---
# Domain that terminates TLS for the API (Caddy) or the tunnel hostname.
API_DOMAIN=api.bestmodel.run
# Public origin of the site/console (passkey ceremonies + CORS).
AUTH_EXPECTED_ORIGIN=https://bestmodel.run
AUTH_RP_ID=bestmodel.run
CORS_ORIGINS=https://bestmodel.run,https://www.bestmodel.run,https://bestmodel-next.vercel.app,http://localhost:3000

# --- oauth sign-in (optional; leave empty to keep the provider off) ---
# GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Hugging Face: Settings -> Connected applications -> New OAuth app
# Callback URL for both: https://api.bestmodel.run/v1/auth/oauth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
# Public base of this API — used to build the OAuth callback URL.
PUBLIC_API_BASE=https://api.bestmodel.run

# --- edge profile: choose ONE ---
# profiles: ["edge"]    -> Caddy on 80/443, DNS A/AAAA record of API_DOMAIN -> this host
# profiles: ["tunnel"]  -> no open ports; TUNNEL_TOKEN from Cloudflare Zero Trust,
#                          route the tunnel hostname to http://api:8000
# docker compose -f deploy/docker-compose.prod.yml --profile edge up -d
