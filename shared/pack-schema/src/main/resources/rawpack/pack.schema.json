{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestmodel.run/rawpack/pack.schema.json",
  "title": "rawpack — capture pack contract v1",
  "description": "One capture = one directory. manifest.json lists every file with sha256; capture.jsonl has one CaptureRecord per frame; imu.jsonl has one ImuRecord per sample; stages read a pack and write result.json (StageResult). This file is the only definition; Kotlin models (shared/pack-schema) and Python/Bend stages validate against it.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rfc3339": { "type": "string", "format": "date-time" },
    "relpath": { "type": "string", "pattern": "^(?!.*(^|/)\\.\\.(/|$))[^/\\\\][^\\\\]*$", "description": "relative to the pack directory, forward slashes, never absolute, no `..` segment" },
    "FileKind": {
      "type": "string",
      "enum": ["raw_dng", "jpeg", "jpeg_ultrahdr", "capture_jsonl", "imu_jsonl", "calib_json", "vendor_jpeg", "vendor_dng", "derived", "other"]
    },
    "FileEntry": {
      "type": "object",
      "required": ["path", "kind", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relpath" },
        "kind": { "$ref": "#/$defs/FileKind" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "derivable": { "type": "boolean", "description": "true when the server can recompute this file from the raw frames (derived/ sidecars)" }
      }
    },
    "FrameRole": { "type": "string", "enum": ["reference", "burst", "underexposed", "bracket"] },
    "FrameEntry": {
      "type": "object",
      "required": ["index", "path", "role", "timestamp_ns", "exposure_ns", "iso"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/relpath" },
        "role": { "$ref": "#/$defs/FrameRole" },
        "timestamp_ns": { "type": "integer", "minimum": 0, "description": "SENSOR_TIMESTAMP, same clock as imu.jsonl" },
        "exposure_ns": { "type": "integer", "minimum": 1 },
        "iso": { "type": "integer", "minimum": 1 }
      }
    },
    "SensorMode": {
      "type": "object",
      "required": ["camera_id", "raw_width", "raw_height", "binning", "reason"],
      "additionalProperties": false,
      "properties": {
        "camera_id": { "type": "string" },
        "physical_camera_id": { "type": ["string", "null"] },
        "raw_width": { "type": "integer", "minimum": 1 },
        "raw_height": { "type": "integer", "minimum": 1 },
        "binning": { "type": "string", "enum": ["none", "2x2", "4x4"] },
        "reason": { "type": "string", "description": "why this mode was chosen (motion/light/user); the on-device decision, recorded, never hidden" }
      }
    },
    "Device": {
      "type": "object",
      "required": ["model", "os", "app_version"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "description": "Build.MODEL, e.g. SM-S938B" },
        "soc": { "type": ["string", "null"], "description": "ro.soc.model when readable" },
        "os": { "type": "string", "description": "Android release, e.g. 16" },
        "app_version": { "type": "string" }
      }
    },
    "Manifest": {
      "type": "object",
      "required": ["schema", "pack_id", "captured_at", "device", "sensor_mode", "frames", "files"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "rawpack/manifest@1" },
        "pack_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{3,127}$" },
        "captured_at": { "$ref": "#/$defs/rfc3339" },
        "device": { "$ref": "#/$defs/Device" },
        "sensor_mode": { "$ref": "#/$defs/SensorMode" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FrameEntry" } },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FileEntry" } },
        "notes": { "type": "string" }
      }
    },
    "OisSample": {
      "type": "object",
      "required": ["t_ns", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "t_ns": { "type": "integer" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "CaptureRecord": {
      "type": "object",
      "description": "One line of capture.jsonl — the CaptureResult keys the pack contract requires; extra Camera2 keys are allowed (additionalProperties) so no information is dropped on the phone.",
      "required": ["frame_index", "timestamp_ns", "exposure_ns", "iso", "frame_duration_ns"],
      "additionalProperties": true,
      "properties": {
        "frame_index": { "type": "integer", "minimum": 0 },
        "timestamp_ns": { "type": "integer", "minimum": 0 },
        "exposure_ns": { "type": "integer", "minimum": 1 },
        "iso": { "type": "integer", "minimum": 1 },
        "frame_duration_ns": { "type": "integer", "minimum": 1 },
        "focus_distance_diopters": { "type": ["number", "null"] },
        "aperture": { "type": ["number", "null"] },
        "rolling_shutter_skew_ns": { "type": ["integer", "null"] },
        "ois_samples": { "type": "array", "items": { "$ref": "#/$defs/OisSample" } },
        "noise_profile": {
          "type": ["array", "null"],
          "description": "SENSOR_NOISE_PROFILE per CFA channel: [[S, O], ...]",
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
        },
        "black_level": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "white_level": { "type": ["integer", "null"] },
        "color_correction_gains": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "faces": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 } },
        "scene_flicker": { "type": ["string", "null"], "enum": ["none", "50hz", "60hz", null] }
      }
    },
    "ImuRecord": {
      "type": "object",
      "required": ["t_ns", "kind", "x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "t_ns": { "type": "integer" },
        "kind": { "type": "string", "enum": ["gyro", "accel"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "StageOutput": {
      "type": "object",
      "required": ["path", "kind", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/relpath" },
        "kind": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "StageResult": {
      "type": "object",
      "description": "result.json written by every stage implementation, in any language. The orchestrator and bench/ read only this.",
      "required": ["schema", "stage", "impl", "version", "inputs_sha256", "ok", "outputs", "metrics"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "rawpack/stage-result@1" },
        "stage": { "type": "string", "pattern": "^s[0-9]+-[a-z0-9-]+$" },
        "impl": { "type": "string", "description": "e.g. python-cuda, bend2, bash" },
        "version": { "type": "string" },
        "inputs_sha256": { "$ref": "#/$defs/sha256", "description": "sha256 of the input manifest.json — ties the result to one exact pack" },
        "ok": { "type": "boolean" },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/StageOutput" } },
        "metrics": {
          "type": "object",
          "required": ["wall_s"],
          "additionalProperties": true,
          "properties": {
            "wall_s": { "type": "number", "minimum": 0 },
            "gpu_s": { "type": ["number", "null"] }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
