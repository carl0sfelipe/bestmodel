{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "runtime_stdout",
        "runtime_stderr",
        "runtime_config",
        "gpu_smi_trace",
        "system_topology",
        "screenshot",
        "prompt_template"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "BenchmarkArtifact": {
      "properties": {
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "sha256"
      ],
      "title": "BenchmarkArtifact",
      "type": "object"
    },
    "BenchmarkMetrics": {
      "properties": {
        "ttft_ms": {
          "minimum": 0,
          "title": "Ttft Ms",
          "type": "number"
        },
        "prefill_tok_s": {
          "minimum": 0,
          "title": "Prefill Tok S",
          "type": "number"
        },
        "decode_tok_s": {
          "minimum": 0,
          "title": "Decode Tok S",
          "type": "number"
        },
        "peak_vram_mib": {
          "default": 0,
          "minimum": 0,
          "title": "Peak Vram Mib",
          "type": "integer"
        },
        "power_watt_avg": {
          "minimum": 0,
          "title": "Power Watt Avg",
          "type": "number"
        },
        "seconds_per_clip": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds Per Clip"
        },
        "it_per_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "It Per S"
        },
        "frames_per_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames Per S"
        }
      },
      "required": [
        "ttft_ms",
        "prefill_tok_s",
        "decode_tok_s",
        "power_watt_avg"
      ],
      "title": "BenchmarkMetrics",
      "type": "object"
    },
    "BenchmarkScenario": {
      "description": "LLM scenario (0.9.0 contract; constructible as before).",
      "properties": {
        "scenario_kind": {
          "const": "llm",
          "default": "llm",
          "title": "Scenario Kind",
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "generated_tokens": {
          "exclusiveMinimum": 0,
          "title": "Generated Tokens",
          "type": "integer"
        },
        "batch_size": {
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "context_tokens": {
          "exclusiveMinimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        }
      },
      "required": [
        "prompt_tokens",
        "generated_tokens",
        "batch_size",
        "context_tokens"
      ],
      "title": "BenchmarkScenario",
      "type": "object"
    },
    "RuntimeEngine": {
      "enum": [
        "llama_cpp",
        "ollama",
        "vllm",
        "sglang",
        "exllamav2",
        "tensorrt_llm",
        "mlx",
        "lmstudio",
        "comfyui"
      ],
      "title": "RuntimeEngine",
      "type": "string"
    },
    "VideoScenario": {
      "description": "Video/diffusion scenario (\u00c9pico 1).\n\nOwn fields, never the token fields of BenchmarkScenario (AD-1).\n``scenario_kind`` is required so a video payload can never validate as an\nLLM scenario by accident.",
      "properties": {
        "scenario_kind": {
          "const": "video",
          "title": "Scenario Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "steps": {
          "exclusiveMinimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "cfg": {
          "exclusiveMinimum": 0,
          "title": "Cfg",
          "type": "number"
        },
        "shift": {
          "default": 5.0,
          "minimum": 0,
          "title": "Shift",
          "type": "number"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "scenario_kind",
        "width",
        "height",
        "frames",
        "steps",
        "cfg",
        "seed"
      ],
      "title": "VideoScenario",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeEngine"
    },
    "runtime_version": {
      "title": "Runtime Version",
      "type": "string"
    },
    "hardware_fingerprint": {
      "title": "Hardware Fingerprint",
      "type": "string"
    },
    "scenario": {
      "anyOf": [
        {
          "$ref": "#/$defs/BenchmarkScenario"
        },
        {
          "$ref": "#/$defs/VideoScenario"
        }
      ],
      "title": "Scenario"
    },
    "metrics": {
      "$ref": "#/$defs/BenchmarkMetrics"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchmarkArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "recipe_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recipe Id"
    }
  },
  "required": [
    "run_id",
    "runtime",
    "runtime_version",
    "hardware_fingerprint",
    "scenario",
    "metrics"
  ],
  "title": "BenchmarkReport",
  "type": "object"
}
